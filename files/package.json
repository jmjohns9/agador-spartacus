{
  "name": "silverado-dx",
  "version": "1.0.0",
  "description": "Project Agador Spartacus — OBD-II diagnostic suite for any OBD-II vehicle",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "concurrently \"npm run watch:main\" \"npm run watch:renderer\" \"wait-on dist/main/main.js && electron .\"",
    "watch:main": "tsc -p tsconfig.main.json --watch",
    "watch:renderer": "webpack --config webpack.renderer.js --watch",
    "build": "tsc -p tsconfig.main.json && webpack --config webpack.renderer.js",
    "dist": "npm run build && electron-builder",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.silveradodx.obd2",
    "productName": "Project Agador Spartacus",
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg",
        "zip"
      ],
      "minimumSystemVersion": "13.0",
      "icon": "build/icon.icns"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "concurrently": "^8.0.0",
    "css-loader": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "html-webpack-plugin": "^5.0.0",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "wait-on": "^7.0.0",
    "webpack": "^5.0.0",
    "webpack-cli": "^5.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.104.1",
    "@tabler/icons-webfont": "^3.44.0",
    "electron-store": "^8.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "recharts": "^2.0.0",
    "serialport": "^12.0.0",
    "zustand": "^4.0.0"
  }
}
