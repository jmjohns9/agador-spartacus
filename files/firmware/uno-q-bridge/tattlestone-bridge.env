# Settings for tattlestone-bridge.service. Copy to /etc/default/tattlestone-bridge
# and restart the service. Every line is optional.

# Listen on one interface only, e.g. the board's Wi-Fi address (hostname -I).
# Default: 0.0.0.0, every interface.
#TATTLESTONE_BRIDGE_HOST=192.168.1.33

# TCP port. Default 35000, the usual Wi-Fi ELM327 port.
#TATTLESTONE_BRIDGE_PORT=35000

# Where the pairing token lives. The unit already sets this; change it only if
# you keep the token somewhere else.
#TATTLESTONE_BRIDGE_TOKEN_FILE=/etc/tattlestone/bridge-token
